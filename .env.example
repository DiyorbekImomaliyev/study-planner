# Copy to .env (then: chmod 600 .env). Never commit .env.

# Brightspace (D2L): Calendar > Subscribe > "All Calendars and Tasks" > copy the link.
D2L_ICS_URL=https://your-school.example/d2l/le/calendar/feed/user/feed.ics?token=...

# Telegram: create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Your chat id: send your bot /start, then run `.venv/bin/planner chat-id`.
TELEGRAM_CHAT_ID=
